{
  "_notes": [
    "POSSIBLE BUG: after an abort the session is saved with taskState `working`. The chat remembers a task that has actually been cancelled, and the next turn resends its taskId.",
    "Neither request carries the abort signal (`signal: false`), so neither the SDK nor fetch can see the stop."
  ],
  "requests": [
    {
      "method": "GET",
      "url": "https://agent.example.test/a2a/.well-known/agent-card.json",
      "authorization": "Bearer tok-cinna-golden",
      "signal": false
    },
    {
      "method": "POST",
      "url": "https://agent.example.test/a2a/",
      "authorization": "Bearer tok-cinna-golden",
      "signal": false,
      "body": {
        "jsonrpc": "2.0",
        "method": "message/stream",
        "params": {
          "message": {
            "kind": "message",
            "messageId": "<messageId#1>",
            "role": "user",
            "parts": [
              {
                "kind": "text",
                "text": "Check the cluster"
              }
            ]
          },
          "configuration": {
            "acceptedOutputModes": [
              "text/plain",
              "application/json"
            ]
          }
        },
        "id": 1
      }
    }
  ],
  "sessionReads": [
    null
  ],
  "sessionUpserts": [
    {
      "chatId": "chat-golden",
      "agentId": "agent-remote-1",
      "contextId": "ctx-cancel-1",
      "taskId": "task-cancel-1",
      "taskState": "working"
    }
  ],
  "taskIdsSurfaced": [
    "task-cancel-1"
  ],
  "clientsSurfaced": 1
}
