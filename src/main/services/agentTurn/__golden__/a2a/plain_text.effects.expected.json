{
  "_notes": [
    "onTaskId fires on every task and status-update frame, not once per distinct id, hence three identical entries.",
    "The upsert saves the taskId with taskState completed. The next turn on this chat sends that taskId again (see resume_remembered_context)."
  ],
  "requests": [
    {
      "method": "GET",
      "url": "https://agent.example.test/a2a/.well-known/agent-card.json",
      "authorization": null,
      "signal": true
    },
    {
      "method": "POST",
      "url": "https://agent.example.test/a2a/",
      "authorization": null,
      "signal": true,
      "body": {
        "jsonrpc": "2.0",
        "method": "message/stream",
        "params": {
          "message": {
            "kind": "message",
            "messageId": "<messageId#1>",
            "role": "user",
            "parts": [
              {
                "kind": "text",
                "text": "Say hello"
              }
            ]
          },
          "configuration": {
            "acceptedOutputModes": [
              "text/plain",
              "application/json"
            ]
          }
        },
        "id": 1
      }
    }
  ],
  "sessionReads": [
    null
  ],
  "sessionUpserts": [
    {
      "chatId": "chat-golden",
      "agentId": "agent-remote-1",
      "contextId": "ctx-plain-1",
      "taskId": "task-plain-1",
      "taskState": "completed"
    }
  ],
  "taskIdsSurfaced": [
    "task-plain-1",
    "task-plain-1",
    "task-plain-1"
  ],
  "clientsSurfaced": 1
}
