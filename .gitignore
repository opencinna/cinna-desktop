node_modules
dist
out
.DS_Store
.eslintcache
*.log*
*.tsbuildinfo
.env
.env.*
!.env.example
e2e/test-results
# Playwright writes here when a spec passes a repo-relative screenshot path.
test-results
e2e/playwright-report

# `make live-flow` writes its run results here (chat dumps, logs, screenshots).
/scripts/live/results/

# `make kit-sync` builds the contract bundle here before swapping it into
# resources/; kept outside resources/ so packaging never sees it.
/scripts/kit-sync/.work/

# Local plans and drafts; never committed.
/drafts/

# The bundled kit is core's tree byte for byte; a global ignore (e.g. of
# `.claude/settings.local.json`) must not drop a file of it from the repo.
!/resources/cinna-agent-kit/**

# Bytecode Python writes beside the skill runtime when an agent imports it in development.
/resources/skill-runtime/**/__pycache__/

# The macOS speech helper, built by scripts/build-speech-helper.sh.
/resources/speech/
