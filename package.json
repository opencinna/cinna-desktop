{
  "name": "cinna-desktop",
  "version": "0.11.4",
  "description": "Desktop client for remote agents (MCP, A2A, OpenCinna)",
  "author": "Evgenii Leksunin <evgeny-l@opencinna.io>",
  "homepage": "https://opencinna.io",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:packaged:acp": "node scripts/check-packaged-acp.mjs",
    "test:packaged:main": "node scripts/check-packaged-main.cjs",
    "test:contract": "vitest run -c vitest.contract.config.ts",
    "contract:docs": "node --experimental-strip-types scripts/generate-contract-docs.mjs",
    "test:packaging": "node --test scripts/packaged-kit.test.cjs scripts/packaged-dependencies.test.cjs scripts/patch-codex-acp.test.cjs scripts/patch-claude-agent-acp.test.cjs scripts/release-draft.test.cjs",
    "test:e2e": "electron-vite build && playwright test -c e2e/playwright.config.ts",
    "test:e2e:only": "playwright test -c e2e/playwright.config.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:mac": "electron-vite build && sh scripts/build-speech-helper.sh && electron-builder --mac",
    "build:mac:unsigned": "electron-vite build && sh scripts/build-speech-helper.sh && electron-builder --mac -c.mac.identity=null -c.mac.notarize=false",
    "notarize:dmgs": "for f in dist/cinna-desktop-*.dmg; do echo \"--- $f ---\" && xcrun notarytool submit \"$f\" --apple-id \"$APPLE_ID\" --team-id \"$APPLE_TEAM_ID\" --password \"$APPLE_APP_SPECIFIC_PASSWORD\" --wait && xcrun stapler staple \"$f\"; done",
    "release:mac": "electron-vite build && sh scripts/build-speech-helper.sh && node scripts/release-draft.cjs && electron-builder --mac --publish always",
    "release:linux": "electron-vite build && node scripts/release-draft.cjs && electron-builder --linux --publish always",
    "release:all": "electron-vite build && sh scripts/build-speech-helper.sh && node scripts/release-draft.cjs && electron-builder --mac --linux --publish always",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps && node scripts/patch-codex-acp.cjs && node scripts/patch-claude-agent-acp.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "test:hub": "node scripts/check-hub-boundary.mjs && node scripts/check-hub-core.mjs"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.14",
    "@agentclientprotocol/claude-agent-acp": "0.101.0",
    "@agentclientprotocol/codex-acp": "2.5.0",
    "@agentclientprotocol/sdk": "2.4.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@anthropic-ai/sdk": "^1.6.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@google/genai": "^3.0.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@scure/bip39": "^2.4.0",
    "@tanstack/react-query": "^5.106.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.11",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "libsodium-wrappers-sumo": "^0.8.4",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.70.0",
    "nanoid": "^6.0.2",
    "officeparser": "~8.4.1",
    "openai": "^7.52.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "socket.io-client": "^4.8.4",
    "undici": "8.12.4",
    "unified": "11.0.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "3.4.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "dotenv": "^18.0.9",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.27.7",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "socket.io": "^4.8.4",
    "ssri": "^12.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  }
}
